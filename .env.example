# Copiá este archivo como .env para desarrollo local. En Hostinger, cargá estas
# mismas variables en hPanel > Web App de Node.js > Variables de entorno.

# Base de datos MySQL (hPanel > Bases de datos > Administración de MySQL).
# Las tablas se crean solas en el primer arranque.
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# Administrador inicial: se crea en el primer arranque si no existe ningún administrador.
# Después de entrar por primera vez podés borrar INITIAL_ADMIN_PASSWORD.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_NAME=Administrador

# IA: se usa el primer proveedor con clave: Gemini, OpenAI, Claude.
# AI_PROVIDER=gemini|openai|claude lo fija aunque haya otras claves cargadas.
AI_PROVIDER=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Opcional: correo para "¿Olvidaste tu contraseña?" (por ejemplo, un email de Hostinger).
# Sin SMTP_HOST, la recuperación la hace un administrador desde Configuración > Usuarios.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Dirección pública del sitio, para los enlaces de los correos (ej. https://compras.tudominio.com)
APP_URL=
